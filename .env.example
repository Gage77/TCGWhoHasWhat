# The passphrase you share with your playgroup. Everything is behind it.
# Unset in development (npm run dev) means no gate; unset in a production
# build means the app refuses to serve, since that is far more likely to be a
# forgotten deploy step than a decision to publish everyone's collection.
GROUP_PASSWORD=

# Set to 1 only if this really is meant to be readable by anyone with the URL.
# ALLOW_PUBLIC=1

# Hosted libSQL. Without these the app writes to ./data/collections.db, which
# does not survive on a serverless host — so a production build with neither
# this nor ALLOW_LOCAL_DB refuses to serve rather than lose an upload.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Set to 1 when self-hosting somewhere with a disk that survives restarts, to
# use ./data/collections.db in production on purpose.
# ALLOW_LOCAL_DB=1

# Where to complain if this app misbehaves. Sent to Scryfall and Deckbox in
# the User-Agent; only worth setting if you have forked this somewhere else.
# APP_CONTACT_URL=https://github.com/you/your-fork
